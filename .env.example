# Configure the model key inside Dify. Local code only needs the app Service API key.
# Keep this example blank; copy to .env and fill values locally.
DIFY_API_KEY=
DIFY_DIAGNOSIS_API_KEY=
DIFY_STRATEGY_API_KEY=
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_MODEL_NAME=
DIFY_WORKFLOW_REVISION=clothing-review-v1
